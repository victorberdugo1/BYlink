module solution;

fn solve(n: i32) -> i32 {
    let mut result: i32 = n;
    let mut x: i32 = n;
    let mut p: i32 = 2;
    while p * p <= x {
        if x % p == 0 {
            while x % p == 0 {
                x = x / p;
            }
            result = result - result / p;
        }
        p = p + 1;
    }
    if x > 1 {
        result = result - result / x;
    }
    return result;
}
