module solution;

fn divisor_sum(n: i32) -> i32 {
    let mut s: i32 = 0;
    let mut d: i32 = 1;
    while d < n {
        if n % d == 0 {
            s = s + d;
        }
        d = d + 1;
    }
    return s;
}

fn solve(n: i32) -> i32 {
    let mut count: i32 = 0;
    let mut k: i32 = 2;
    while k <= n {
        if divisor_sum(k) == k {
            count = count + 1;
        }
        k = k + 1;
    }
    return count;
}
