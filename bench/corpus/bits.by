module bits;

fn popcount(x: u32) -> u32 {
    let mut v: u32 = x;
    let mut c: u32 = 0;
    while v != 0 {
        c = c + (v & 1);
        v = v / 2;
    }
    return c;
}

fn parity(x: u32) -> bool {
    return popcount(x) % 2 == 1;
}

fn reverse8(x: u8) -> u8 {
    let mut v: u8 = x;
    let mut r: u8 = 0;
    let mut i: u8 = 0;
    while i < 8 {
        r = r * 2 + (v & 1);
        v = v / 2;
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    let mut acc: u32 = 0;
    let mut i: u32 = 0;
    while i < 256 {
        acc = acc + popcount(i) + (reverse8(i as u8) as u32);
        if parity(i) {
            acc = acc ^ 0x55;
        }
        i = i + 1;
    }
    return (acc % 256) as i32;
}
