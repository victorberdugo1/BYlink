module collatz;

fn steps(start: u64) -> u32 {
    let mut n: u64 = start;
    let mut count: u32 = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        }
        count = count + 1;
    }
    return count;
}

fn main() -> i32 {
    let mut best: u32 = 0;
    let mut best_start: u64 = 1;
    let mut i: u64 = 1;
    while i < 1000 {
        let s: u32 = steps(i);
        if s > best {
            best = s;
            best_start = i;
        }
        i = i + 1;
    }
    return (best_start % 200) as i32;
}
